<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>clotheshavepockets</AssemblyName>
		<Platforms>AnyCPU</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>

		<!-- KEEP THE LINE NUMBERS, DROP THE PERSONAL PATH.

		     The shipped .pdb is what puts file names and line numbers into a crash
		     report, and that has been the whole diagnosis more than once. But without
		     this the recorded source root is absolute, so every stranger's log would
		     carry "E:\Game Mods\Improved Vintage Story\Clothes Have Pockets\...".

		     PathMap rewrites it, so traces read "src\PocketInventory.cs:line 42" with
		     nothing about this machine in front. Verify by reading the .pdb as bytes
		     and grepping for a drive letter and the username - both should be absent. -->
		<PathMap>$(MSBuildProjectDirectory)=.</PathMap>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="tools\**" />
		<None Include="tools\**" />
		<Compile Remove="backup\**" />
		<None Include="backup\**" />
		<Compile Remove="mods\**" />
		<None Include="mods\**" />
	</ItemGroup>

	<!-- ASSETS ARE NOT BUILD OUTPUT. They live in mods\clotheshavepockets_<version>\assets\
	     beside modinfo.json and modicon.png, and package2.py zips them from there. Only the
	     dll, pdb and deps come out of bin\. One source per mod - the previous project had
	     this split across two homes and it cost two separate mistakes in one evening. -->

	<!-- NO 0Harmony REFERENCE, DELIBERATELY.

	     The whole point of this rebuild is that it needs no Harmony: GuiDialog's OnOpened
	     and OnClosed are public events, and GuiDialogCharacterBase is public API, so the
	     panel attaches to vanilla dialogs without patching them. Leaving the reference out
	     means we cannot quietly drift back into patching non-public client code. If a
	     future change genuinely needs Harmony, add the reference in the same commit as a
	     session-log entry saying what forced it. -->

	<!-- WHERE THE GAME DLLS ARE (1.22.7) - the folder holding VintagestoryAPI.dll (with Lib\ and Mods\ inside it).

	     Looked for in this order:
	       1. gamepath.props next to this file - YOUR PC's game folder. It is in .gitignore, so it never
	          goes to GitHub. Copy gamepath.props.example to gamepath.props and put your folder in it.
	       2. the VINTAGE_STORY environment variable (the cloud build uses this).
	       3. the default below: the Wax Light Launcher install.
	     If none of them has the game, the build stops with a message saying which folder it tried. -->
	<Import Project="gamepath.props" Condition="Exists('gamepath.props')" />
	<PropertyGroup>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == '' And '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == ''">..\..\..\Games\Vintage Story\Wax Light Launcher\Wax Light Info\versions\1.22.7</VintageStoryPath>
	</PropertyGroup>

	<!-- A plain message instead of hundreds of "type not found" errors when the game folder is wrong. -->
	<Target Name="CheckGameFolder" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll')"
		       Text="Vintage Story's game files were not found in: $([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(VintageStoryPath)')))) - copy gamepath.props.example to gamepath.props (next to ClothesHavePockets.csproj) and put the folder that contains VintagestoryAPI.dll in it." />
	</Target>

	<ItemGroup>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="protobuf-net">
			<HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="SkiaSharp">
			<HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Vintagestory">
			<HintPath>$(VintageStoryPath)\Vintagestory.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryAPI">
			<HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryLib">
			<HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSSurvivalMod">
			<HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSEssentials">
			<HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
